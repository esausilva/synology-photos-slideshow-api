# ==============================================================================
# Synology Photos Slideshow - Server Environment Configuration (Template)
# Copy this file to .env and replace placeholder values with your own.
# ==============================================================================

# ------------------------------------------------------------------------------
# ASP.NET Core Runtime Settings
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Release

# ------------------------------------------------------------------------------
# Synology NAS Connection
# ------------------------------------------------------------------------------
UriBase__ServerIpOrHostname=<<SERVER_IP_OR_HOSTNAME>>
UriBase__Port=5000

# ------------------------------------------------------------------------------
# Synology User Credentials
# ------------------------------------------------------------------------------
SynologyUser__Account=<<ACCOUNT>>
SynologyUser__Password=<<PASSWORD>>

# ------------------------------------------------------------------------------
# Photo Search & Download Options
# ------------------------------------------------------------------------------
SynoApiOptions__FileStationSearchFolders__0=/photo/Family
# SynoApiOptions__FileStationSearchFolders__1=/photo/Vacation
SynoApiOptions__NumberOfPhotoDownloads=10

# ------------------------------------------------------------------------------
# Third-Party Services
# ------------------------------------------------------------------------------
ThirdPartyServices__EnableGeolocation=false
ThirdPartyServices__EnableDistributedCache=true

# ------------------------------------------------------------------------------
# Google Maps Geocoding API (Required if EnableGeolocation is true)
# ------------------------------------------------------------------------------
GoogleMapsOptions__ApiKey=<<GOOGLE_MAPS_API_KEY>>

# ------------------------------------------------------------------------------
# Photo Download Scheduled Job (Hangfire)
# ------------------------------------------------------------------------------
# DayOfWeek: 0 = Sunday, 1 = Monday, 2 = Tuesday, 3 = Wednesday, 4 = Thursday, 5 = Friday, 6 = Saturday
# Hour: 0-23 (24-hour format)
# Minute: 0-59
# TimeZoneId: IANA timezone identifier (e.g. America/Chicago, America/New_York)
PhotoDownloadScheduledJobOptions__Enabled=true
PhotoDownloadScheduledJobOptions__DayOfWeek=0
PhotoDownloadScheduledJobOptions__Hour=12
PhotoDownloadScheduledJobOptions__Minute=3
PhotoDownloadScheduledJobOptions__TimeZoneId=America/Chicago

# ------------------------------------------------------------------------------
# Favorites Watcher
# ------------------------------------------------------------------------------
FavoritesWatcherOptions__DebounceDelayInSeconds=10

# ------------------------------------------------------------------------------
# Redis Connection String
# ------------------------------------------------------------------------------
ConnectionStrings__Redis=redis.slideshow:6379,abortConnect=false,connectTimeout=10000

# ------------------------------------------------------------------------------
# Storage Volumes (Host Paths)
# ------------------------------------------------------------------------------
SLIDES_VOLUME_PATH=./.slides
LOGS_VOLUME_PATH=./.logs
REDIS_DATA_PATH=./.redis-data

# ------------------------------------------------------------------------------
# Client Configuration
# ------------------------------------------------------------------------------
# Internal Docker network URL used by SSR server functions (Node.js context)
SERVER__API_BASE_URL=http://<<SERVER_IP>>:5097

# External/browser-facing API URL used by the web client (SignalR, direct requests)
# Set to your server IP or domain (e.g. http://192.168.0.229:5097) when accessing over LAN
CLIENT__API_BASE_URL=http://<<SERVER_IP>>:5097
